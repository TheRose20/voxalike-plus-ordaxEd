{
  "manifest_version": 3,
  "name": "ESPERION",
  "version": "3.0.1",
  "description": "ESPERION для voxalike.com: запись по фрагментам, FX-движок, пресеты, Мастер реплики, проверка записи, шумодав, эквалайзер, измерение громкости (LUFS), экспорт WAV.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ESPERION",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://voxalike.com/*",
        "https://www.voxalike.com/*"
      ],
      "js": [
        "vxp-main.js",
        "vxp-bg.js",
        "vxp-fx.js",
        "vxp-denoise.js",
        "vxp-room.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "111",
  "version_name": "3.0 ESPERION"
}